# Copy to .env.local for local dev. Never commit real values.
# Postgres (Render Internal Database URL in production). Optional locally —
# the app falls back to local disk storage under ./data when unset.
DATABASE_URL=

# OpenAI API key — required for photo analysis and image generation.
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# FIXMESSY_VISION_MODEL=gpt-4o
# FIXMESSY_IMAGE_MODEL=gpt-image-1

# Public URL of the deployed app (used for canonical/OG/sitemap)
APP_URL=http://localhost:3000

# Optional: pre-set admin password hash (bcrypt). If unset, set the password
# on first visit to /addy instead.
# ADMIN_PASSWORD_HASH=
